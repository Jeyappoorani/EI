import java.time.LocalDateTime;
import java.time.LocalTime;
import java.time.format.DateTimeParseException;
import java.util.*;

// Single-file runnable Astronaut Daily Schedule Organizer
public class AstronautApp {

    // ======================= Logger (Singleton) =======================
    static class Logger {
        private static volatile Logger instance;
        private Logger() {}
        public static Logger getInstance() {
            if (instance == null) {
                synchronized (Logger.class) {
                    if (instance == null) instance = new Logger();
                }
            }
            return instance;
        }
        public void info(String msg) {
            System.out.println(LocalDateTime.now() + " [INFO] " + msg);
        }
        public void error(String msg) {
            System.err.println(LocalDateTime.now() + " [ERROR] " + msg);
        }
    }

    // ======================= Task Model =======================
    static class Task {
        private final String description;
        private final LocalTime start, end;
        private final String priority;
        private boolean completed;

        public Task(String desc, LocalTime start, LocalTime end, String priority) {
            if (!start.isBefore(end)) throw new IllegalArgumentException("Invalid time range: start must be before end");
            this.description = desc;
            this.start = start;
            this.end = end;
            this.priority = priority;
            this.completed = false;
        }

        public String getDescription() { return description; }
        public LocalTime getStart() { return start; }
        public LocalTime getEnd() { return end; }
        public String getPriority() { return priority; }
        public boolean isCompleted() { return completed; }
        public void markCompleted() { this.completed = true; }

        @Override
        public String toString() {
            return String.format("%s - %s: %s [%s]%s",
                    start, end, description, priority, completed ? " ✔" : "");
        }
    }

    // ======================= Task Factory =======================
    static class TaskFactory {
        // expects times like "07:00" or "7:00"
        public static Task createTask(String desc, String start, String end, String priority) {
            try {
                LocalTime s = LocalTime.parse(start.trim());
                LocalTime e = LocalTime.parse(end.trim());
                return new Task(desc.trim(), s, e, priority.trim());
            } catch (DateTimeParseException ex) {
                throw new IllegalArgumentException("Invalid time format (expected HH:MM).");
            }
        }
    }

    // ======================= Observer interfaces & notifier =======================
    interface Observer {
        void update(String event, Task task);
    }

    static class ConsoleNotifier implements Observer {
        @Override
        public void update(String event, Task task) {
            System.out.println("[NOTIFY] " + event + (task != null ? " -> " + task : ""));
        }
    }

    // ======================= Schedule Manager (Singleton + Observer) =======================
    static class ScheduleManager {
        private static volatile ScheduleManager instance;
        private final List<Task> tasks = new ArrayList<>();
        private final List<Observer> observers = new ArrayList<>();

        private ScheduleManager() {}

        public static ScheduleManager getInstance() {
            if (instance == null) {
                synchronized (ScheduleManager.class) {
                    if (instance == null) instance = new ScheduleManager();
                }
            }
            return instance;
        }

        public void registerObserver(Observer o){ if (o != null) observers.add(o); }
        private void notifyAllObservers(String event, Task task){
            for (Observer o : observers) {
                try { o.update(event, task); } catch(Exception ex) { Logger.getInstance().error("Observer failed: " + ex.getMessage()); }
            }
        }

        // Overlap if new.start < existing.end && new.end > existing.start
        private boolean overlaps(Task a, Task b) {
            return a.getStart().isBefore(b.getEnd()) && a.getEnd().isAfter(b.getStart());
        }

        public synchronized void addTask(Task t){
            for (Task e : tasks) {
                if (overlaps(t, e)) {
                    notifyAllObservers("CONFLICT with " + e.getDescription(), t);
                    Logger.getInstance().error("Task conflict detected with: " + e.getDescription());
                    return;
                }
            }
            tasks.add(t);
            tasks.sort(Comparator.comparing(Task::getStart));
            notifyAllObservers("ADDED", t);
            Logger.getInstance().info("Task added: " + t.getDescription());
        }

        public synchronized void removeTask(String desc){
            boolean removed = tasks.removeIf(t -> {
                if (t.getDescription().equalsIgnoreCase(desc.trim())) {
                    notifyAllObservers("REMOVED", t);
                    return true;
                }
                return false;
            });
            if (!removed) {
                Logger.getInstance().error("Task not found: " + desc);
                System.err.println("Error: Task not found.");
            }
        }

        public synchronized void markComplete(String desc){
            for (Task t : tasks) {
                if (t.getDescription().equalsIgnoreCase(desc.trim())) {
                    if (!t.isCompleted()) {
                        t.markCompleted();
                        notifyAllObservers("COMPLETED", t);
                        Logger.getInstance().info("Task completed: " + t.getDescription());
                    } else {
                        System.out.println("Task already marked completed.");
                    }
                    return;
                }
            }
            Logger.getInstance().error("Task not found: " + desc);
            System.err.println("Error: Task not found.");
        }

        public synchronized void viewTasks(){
            if (tasks.isEmpty()) {
                System.out.println("No tasks scheduled.");
                return;
            }
            System.out.println("Scheduled tasks:");
            for (Task t : tasks) System.out.println("  " + t);
        }

        public synchronized void viewByPriority(String p){
            String pref = p.trim();
            boolean found = false;
            for (Task t : tasks) {
                if (t.getPriority().equalsIgnoreCase(pref)) {
                    if (!found) {
                        System.out.println("Tasks with priority '" + pref + "':");
                        found = true;
                    }
                    System.out.println("  " + t);
                }
            }
            if (!found) System.out.println("No tasks with priority '" + pref + "'.");
        }
    }

    // ======================= Main UI loop =======================
    public static void main(String[] args) {
        ScheduleManager mgr = ScheduleManager.getInstance();
        mgr.registerObserver(new ConsoleNotifier());
        Scanner sc = new Scanner(System.in, "UTF-8");

        while (true) {
            printMenu();
            String line = sc.nextLine().trim();
            if (line.isEmpty()) continue;
            int ch;
            try {
                ch = Integer.parseInt(line);
            } catch (NumberFormatException ex) {
                System.out.println("Invalid selection. Enter a number from the menu.");
                continue;
            }

            try {
                switch (ch) {
                    case 1:
                        System.out.print("Description: ");
                        String desc = sc.nextLine();
                        System.out.print("Start (HH:MM): ");
                        String start = sc.nextLine();
                        System.out.print("End   (HH:MM): ");
                        String end = sc.nextLine();
                        System.out.print("Priority (High/Medium/Low): ");
                        String priority = sc.nextLine();
                        Task t = TaskFactory.createTask(desc, start, end, priority);
                        mgr.addTask(t);
                        break;
                    case 2:
                        System.out.print("Description to remove: ");
                        mgr.removeTask(sc.nextLine());
                        break;
                    case 3:
                        mgr.viewTasks();
                        break;
                    case 4:
                        System.out.print("Description to mark completed: ");
                        mgr.markComplete(sc.nextLine());
                        break;
                    case 5:
                        System.out.print("Priority to filter by: ");
                        mgr.viewByPriority(sc.nextLine());
                        break;
                    case 0:
                        System.out.println("Goodbye!");
                        sc.close();
                        return;
                    default:
                        System.out.println("Invalid option. Choose 0-5.");
                }
            } catch (IllegalArgumentException ex) {
                System.err.println("Error: " + ex.getMessage());
            } catch (Exception ex) {
                System.err.println("Unexpected error: " + ex.getMessage());
                Logger.getInstance().error("Unexpected: " + ex.getMessage());
            }
        }
    }

    private static void printMenu() {
        System.out.println("\n=== Astronaut Daily Schedule ===");
        System.out.println("1. Add Task");
        System.out.println("2. Remove Task");
        System.out.println("3. View Tasks");
        System.out.println("4. Mark Task Completed");
        System.out.println("5. View by Priority");
        System.out.println("0. Exit");
        System.out.print("Choose: ");
    }
}
