package designpatterns.behavioral.observer;
import java.util.*;
import designpatterns.common.Logger;

public class ScheduleManager implements Subject {
    private final List<Task> tasks = new ArrayList<>();
    private final List<Observer> observers = new ArrayList<>();

    public void register(Observer o) { observers.add(o); }
    public void unregister(Observer o) { observers.remove(o); }
    public void notifyObservers(String event, Task t) {
        for (Observer o : observers) o.update(event, t);
    }

    public void addTask(Task t) {
        for (Task e : tasks) {
            if (!(t.getEnd().isBefore(e.getStart()) || t.getStart().isAfter(e.getEnd()))) {
                notifyObservers("CONFLICT", t);
                Logger.getInstance().error("Conflict with " + e.getDescription());
                return;
            }
        }
        tasks.add(t);
        tasks.sort(Comparator.comparing(Task::getStart));
        notifyObservers("ADDED", t);
    }

    public void removeTask(String desc) {
        tasks.removeIf(t -> {
            if (t.getDescription().equals(desc)) {
                notifyObservers("REMOVED", t);
                return true;
            }
            return false;
        });
    }

    public List<Task> viewTasks() { return tasks; }
}
