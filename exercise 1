package designpatterns.structural.composite;
import java.util.*;

public interface FSEntry {
    String getName(); long getSize(); void print(String indent);
}

public class FileLeaf implements FSEntry {
    private final String name; private final long size;
    public FileLeaf(String n,long s){name=n;size=s;}
    public String getName(){return name;}
    public long getSize(){return size;}
    public void print(String indent){System.out.println(indent+"- "+name+" ("+size+" bytes)");}
}

public class FolderComposite implements FSEntry {
    private final String name; private final List<FSEntry> children=new ArrayList<>();
    public FolderComposite(String n){name=n;}
    public void add(FSEntry e){children.add(e);}
    public long getSize(){return children.stream().mapToLong(FSEntry::getSize).sum();}
    public String getName(){return name;}
    public void print(String indent){
        System.out.println(indent+"+ "+name+" ("+getSize()+" bytes)");
        for(FSEntry e:children) e.print(indent+"  ");
    }
}

public class CompositeDemo {
    public static void run(){
        FolderComposite root=new FolderComposite("root");
        root.add(new FileLeaf("readme.txt",1024));
        FolderComposite src=new FolderComposite("src");
        src.add(new FileLeaf("Main.java",2048));
        root.add(src);
        root.print("");
    }
}

