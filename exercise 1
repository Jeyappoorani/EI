// ========== Factory ==========
interface ITask { void execute(); }
class SimpleTask implements ITask{
    private final String d;
    public SimpleTask(String d2){ d = d2; }
    public void execute(){ System.out.println("Executing "+d); }
}
class RecurringTask implements ITask{
    private final String d;
    private final int m;
    public RecurringTask(String d2, int m2){ d=d2; m=m2; }
    public void execute(){ System.out.println("Recurring "+d+" every "+m+" min"); }
}
class TaskFactory {
    public static ITask create(String type, String d, int...m){
        switch(type.toLowerCase()){
            case "simple": return new SimpleTask(d);
            case "recurring": return new RecurringTask(d, m[0]);
            default: throw new IllegalArgumentException("Unknown type");
        }
    }
}
class FactoryDemo {
    public static void run(){
        ITask t1 = TaskFactory.create("simple", "Backup DB");
        ITask t2 = TaskFactory.create("recurring", "Sync Sensors", 15);
        t1.execute(); t2.execute();
    }
}

// ========== Adapter ==========
interface Sensor { double readValue(); String getUnit(); }
class LegacySensor { public int getTemperatureTenths(){ return 253; } }
class LegacySensorAdapter implements Sensor{
    private final LegacySensor l;
    public LegacySensorAdapter(LegacySensor l2){ l = l2; }
    public double readValue(){ return l.getTemperatureTenths()/10.0; }
    public String getUnit(){ return "Celsius"; }
}
class AdapterDemo {
    public static void run(){
        Sensor s = new LegacySensorAdapter(new LegacySensor());
        System.out.println("Temp: "+s.readValue()+" "+s.getUnit());
    }
}

// ========== Composite ==========
interface FSEntry { String getName(); long getSize(); void print(String ind); }
class FileLeaf implements FSEntry{
    private final String n;
    private final long s;
    public FileLeaf(String n2, long s2){ n=n2; s=s2; }
    public String getName(){ return n; }
    public long getSize(){ return s; }
    public void print(String i){ System.out.println(i+"- "+n+" ("+s+" bytes)"); }
}
class FolderComposite implements FSEntry{
    private final String n;
    private final List<FSEntry> kids = new ArrayList<>();
    public FolderComposite(String n2){ n=n2; }
    public void add(FSEntry e){ kids.add(e); }
    public long getSize(){ return kids.stream().mapToLong(FSEntry::getSize).sum(); }
    public String getName(){ return n; }
    public void print(String i){
        System.out.println(i+"+ "+n+" ("+getSize()+" bytes)");
        for(FSEntry e: kids) e.print(i+"  ");
    }
}
class CompositeDemo {
    public static void run(){
        FolderComposite root = new FolderComposite("root");
        root.add(new FileLeaf("readme.txt", 1024));
        FolderComposite src = new FolderComposite("src");
        src.add(new FileLeaf("Main.java", 2048));
        root.add(src);
        root.print("");
    }
}

