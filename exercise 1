package designpatterns.structural.adapter;

public interface Sensor { double readValue(); String getUnit(); }

public class LegacySensor {
    public int getTemperatureTenths(){ return 253; }
}

public class LegacySensorAdapter implements Sensor {
    private final LegacySensor legacy;
    public LegacySensorAdapter(LegacySensor l){ legacy=l; }
    public double readValue(){ return legacy.getTemperatureTenths()/10.0; }
    public String getUnit(){ return "Celsius"; }
}

public class AdapterDemo {
    public static void run(){
        Sensor s=new LegacySensorAdapter(new LegacySensor());
        System.out.println("Temp: "+s.readValue()+" "+s.getUnit());
    }
}

