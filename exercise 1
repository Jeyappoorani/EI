import java.time.LocalDateTime;
import java.time.LocalTime;
import java.util.*;

// ========== Logger ==========
class Logger {
    private static volatile Logger instance;
    private Logger() {}
    public static Logger getInstance() {
        if (instance == null) {
            synchronized (Logger.class) {
                if (instance == null) instance = new Logger();
            }
        }
        return instance;
    }
    public void info(String msg) { System.out.println(LocalDateTime.now()+" [INFO] "+msg); }
    public void error(String msg) { System.err.println(LocalDateTime.now()+" [ERROR] "+msg); }
}

// ========== Observer Pattern ==========
interface Observer { void update(String event, Task task); }
interface Subject { void register(Observer o); void unregister(Observer o); void notifyObservers(String event, Task task); }

class Task {
    private final String desc;
    private final LocalTime start, end;
    private final String prio;

    public Task(String d, LocalTime s, LocalTime e, String p){
        if(!s.isBefore(e)) throw new IllegalArgumentException("Start time must be before end time");
        desc = d; start = s; end = e; prio = p;
    }

    public String getDescription(){ return desc; }
    public LocalTime getStart(){ return start; }
    public LocalTime getEnd(){ return end; }

    public String toString(){ return start+"-"+end+": "+desc+" ["+prio+"]"; }
}

class ScheduleManager implements Subject {
    private final List<Task> tasks = new ArrayList<>();
    private final List<Observer> obs = new ArrayList<>();

    public void register(Observer o){ obs.add(o); }
    public void unregister(Observer o){ obs.remove(o); }
    public void notifyObservers(String e, Task t){ obs.forEach(o -> o.update(e, t)); }

    public void addTask(Task t){
        for(Task e : tasks){
            if(!(t.getEnd().isBefore(e.getStart()) || t.getStart().isAfter(e.getEnd()))){
                notifyObservers("CONFLICT", t);
                Logger.getInstance().error("Conflict with " + e.getDescription());
                return;
            }
        }
        tasks.add(t);
        tasks.sort(Comparator.comparing(Task::getStart));
        notifyObservers("ADDED", t);
    }

    public void removeTask(String d){
        tasks.removeIf(t -> {
            if(t.getDescription().equals(d)){
                notifyObservers("REMOVED", t);
                return true;
            }
            return false;
        });
    }

    public List<Task> viewTasks(){ return tasks; }
}

class ConsoleNotifier implements Observer {
    public void update(String e, Task t){ System.out.println("[ConsoleNotifier] "+e+" => "+t); }
}

class ObserverDemo {
    public static void run(){
        ScheduleManager m = new ScheduleManager();
        m.register(new ConsoleNotifier());
        m.addTask(new Task("Exercise", LocalTime.of(7,0), LocalTime.of(8,0), "High"));
        m.addTask(new Task("Meeting", LocalTime.of(9,0), LocalTime.of(10,0), "Medium"));
        m.addTask(new Task("Conflict", LocalTime.of(9,30), LocalTime.of(10,30), "High"));
        m.viewTasks().forEach(System.out::println);
    }
}

// ========== Strategy Pattern ==========
interface PaymentStrategy { void pay(double amt) throws Exception; }
class CreditCardStrategy implements PaymentStrategy {
    private final String num, name;
    public CreditCardStrategy(String n, String nm){ num=n; name=nm; }
    public void pay(double amt) throws Exception {
        if(num.length() < 12) throw new Exception("Invalid card");
        System.out.println("Paid "+amt+" with CreditCard for "+name);
    }
}
class PayPalStrategy implements PaymentStrategy {
    private final String email;
    public PayPalStrategy(String e){ email=e; }
    public void pay(double amt) throws Exception {
        if(!email.contains("@")) throw new Exception("Invalid email");
        System.out.println("Paid "+amt+" with PayPal for "+email);
    }
}
class PaymentContext {
    private PaymentStrategy s;
    public void setStrategy(PaymentStrategy s2){ s = s2; }
    public void checkout(double amt){
        try { s.pay(amt); } catch(Exception e){ System.err.println(e.getMessage()); }
    }
}
class StrategyDemo {
    public static void run(){
        PaymentContext c = new PaymentContext();
        c.setStrategy(new CreditCardStrategy("123456789012", "Alice"));
        c.checkout(100);
        c.setStrategy(new PayPalStrategy("bob@example.com"));
        c.checkout(50);
    }
}

