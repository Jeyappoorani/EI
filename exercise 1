package designpatterns.behavioral.observer;
import java.time.LocalTime;
import java.util.*;
import designpatterns.common.Logger;

public interface Observer {
    void update(String event, Task task);
}

public interface Subject {
    void register(Observer o);
    void unregister(Observer o);
    void notifyObservers(String event, Task task);
}

public class Task {
    private final String description;
    private final LocalTime start, end;
    private final String priority;
    public Task(String d, LocalTime s, LocalTime e, String p) {
        if (!s.isBefore(e)) throw new IllegalArgumentException("Invalid time");
        this.description = d; this.start = s; this.end = e; this.priority = p;
    }
    public String getDescription() { return description; }
    public LocalTime getStart() { return start; }
    public LocalTime getEnd() { return end; }
    @Override public String toString() {
        return start + " - " + end + ": " + description + " [" + priority + "]";
    }
}

public class ScheduleManager implements Subject {
    private final List<Task> tasks = new ArrayList<>();
    private final List<Observer> observers = new ArrayList<>();

    public void register(Observer o) { observers.add(o); }
    public void unregister(Observer o) { observers.remove(o); }
    public void notifyObservers(String event, Task t) {
        for (Observer o : observers) o.update(event, t);
    }

    public void addTask(Task t) {
        for (Task e : tasks) {
            if (!(t.getEnd().isBefore(e.getStart()) || t.getStart().isAfter(e.getEnd()))) {
                notifyObservers("CONFLICT", t);
                Logger.getInstance().error("Conflict with " + e.getDescription());
                return;
            }
        }
        tasks.add(t);
        tasks.sort(Comparator.comparing(Task::getStart));
        notifyObservers("ADDED", t);
    }

    public void removeTask(String desc) {
        tasks.removeIf(t -> {
            if (t.getDescription().equals(desc)) {
                notifyObservers("REMOVED", t);
                return true;
            }
            return false;
        });
    }

    public List<Task> viewTasks() { return tasks; }
}

public class ConsoleNotifier implements Observer {
    public void update(String event, Task task) {
        System.out.println("[ConsoleNotifier] " + event + " => " + task);
    }
}

public class ObserverDemo {
    public static void run() {
        ScheduleManager m = new ScheduleManager();
        m.register(new ConsoleNotifier());
        m.addTask(new Task("Exercise", LocalTime.of(7,0), LocalTime.of(8,0), "High"));
        m.addTask(new Task("Meeting", LocalTime.of(9,0), LocalTime.of(10,0), "Medium"));
        m.addTask(new Task("Conflict", LocalTime.of(9,30), LocalTime.of(10,30), "High"));
        System.out.println("Tasks:");
        m.viewTasks().forEach(System.out::println);
    }
}

